# Vercel: URL pública del servicio backend, sin barra final.
VITE_API_URL=https://neurolab-api-production.up.railway.app

# Railway: dominio público del frontend que puede usar la API, sin barra final.
NEUROLAB_ALLOWED_ORIGINS=https://neurolab.vercel.app

# Railway los completa automáticamente o el contenedor ya define un valor seguro.
NEUROLAB_TRAINING_DIR=/data/training
TF_CPP_MIN_LOG_LEVEL=2
CUDA_VISIBLE_DEVICES=-1
OMP_NUM_THREADS=2
PYTHONUNBUFFERED=1
